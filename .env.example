# Copy to .env (docker compose reads it automatically). Never commit .env.
# Without TRADIER_TOKEN the API still runs but returns empty/degraded data.
TRADIER_TOKEN=
OPENAI_API_KEY=
# Required for AI analysis and history; AI endpoints are disabled when blank.
AI_PIN=
# Optional Financial Modeling Prep key for the Congress-trades feed. Without it
# the feed falls back to the (currently unreliable) public JSON mirrors.
FMP_API_KEY=
# Set false to disable the intraday snapshot/gamma-gap scheduler.
SCHEDULER_ENABLED=true
# PIN gating watchlist/alert mutations; set it before exposing the app publicly.
WORKSPACE_PIN=
